# Server porti
PORT=3000

# PostgreSQL ulanish satri (Docker ishlatganda 'db:5432', lokalda 'localhost:5432')
DATABASE_URL=postgresql://postgres:postgres_secret_pass@localhost:5432/school_bell

# Agar SSL talab qilinsa (masalan Neon, Supabase, Cloud PG uchun) true qiling
DATABASE_SSL=false

# Sessiya xavfsizlik kaliti (tasodifiy uzun matn)
SESSION_SECRET=change_this_to_a_long_random_secret_string

# Agar HTTPS orqali ochilsa (Nginx/Cloudflare orqali) true qiling
COOKIE_SECURE=false

# Telegram Bot (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
